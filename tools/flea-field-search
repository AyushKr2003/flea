def flea_state(ctx, arm):
    """A state directory holding Flea's shipped defaults and the arm's view, made once per (tree, view)."""
    view = arm.get("view", "list")
    key = (arm["flea_dir"], view)
    if key not in ctx["states"]:
        d = tempfile.mkdtemp(prefix="flea-search-state-")
        os.makedirs(d + "/no-config", exist_ok=True)
        patch = json.dumps({"sort": {"key": "name", "reverse": False}, "view": view})
        subprocess.run([arm["flea_dir"] + "/target/release/flea", "--ui-state", patch],
                       env=dict(ENV, XDG_STATE_HOME=d, XDG_CONFIG_HOME=d + "/no-config"), capture_output=True, check=True)
        ctx["states"][key] = d
    return ctx["states"][key]


