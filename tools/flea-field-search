def session_env():
    """The environment a graphical call needs, rebuilt when this shell came from ssh."""
    env = dict(os.environ)
    run = env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    if not env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        sigs = sorted(os.listdir(os.path.join(run, "hypr")), key=lambda s: os.stat(os.path.join(run, "hypr", s)).st_mtime)
        env["HYPRLAND_INSTANCE_SIGNATURE"] = sigs[-1]
    if not env.get("WAYLAND_DISPLAY"):
        socks = sorted(n for n in os.listdir(run) if n.startswith("wayland-") and not n.endswith(".lock"))
        env["WAYLAND_DISPLAY"] = socks[0]
    return env


ENV = None


def hypr(*args):
    return subprocess.run(["hyprctl", *args], env=ENV, capture_output=True, text=True, timeout=10).stdout


def clients():
    return json.loads(hypr("-j", "clients"))


def monitor():
    m = json.loads(hypr("-j", "monitors"))[0]
    return m


def dispatch(expr):
    out = hypr("dispatch", expr).strip()
    if out != "ok":
        raise RuntimeError("hyprctl dispatch %s answered %r, not ok" % (expr, out))


def park_cursor():
    """The pointer goes to the top right corner, on the bar and outside every window. A key press hides a software
    cursor, and that one changed row at the pointer would otherwise be a change in whatever region it sat over."""
    m = monitor()
    dispatch("hl.dsp.cursor.move({ x = %d, y = 4 })" % (m["x"] + m["width"] - 4))


def focus_window(address):
    dispatch('hl.dsp.focus({ window = "address:%s" })' % address)


def window_by_pid(pids, deadline_s=30):
    """The first mapped client owned by one of pids; waits up to deadline_s."""
    t0 = time.monotonic()
    while time.monotonic() - t0 < deadline_s:
        for c in clients():
            if c.get("pid") in pids and c.get("mapped", True):
                return c
        time.sleep(0.02)
    return None


def descendants(pid):
    """pid and everything under it, read from /proc."""
    out, queue = {pid}, [pid]
    while queue:
        p = queue.pop()
        try:
            for t in os.listdir("/proc/%d/task" % p):
                with open("/proc/%d/task/%s/children" % (p, t)) as f:
                    for k in f.read().split():
                        if int(k) not in out:
                            out.add(int(k))
                            queue.append(int(k))
        except OSError:
            pass
    return out


class Recorder:
    """tools/flea-framecap as a child process whose lines are read as they arrive."""

    def __init__(self, binary, region, masks=(), dump_prefix=None, dump_rect=None):
        self.dump_rect = dump_rect or region
        cmd = [binary, "-r", "%d,%d,%d,%d" % region]
        for m in masks:
            cmd += ["-m", "%d,%d,%d,%d" % m]
        if dump_prefix:
            cmd += ["-d", dump_prefix, "-w", "%d,%d,%d,%d" % self.dump_rect]
        self.frames = []
        self.detail = []
        self.dumps = []
        self.header = None
        self.lock = threading.Lock()
        self.proc = subprocess.Popen(cmd, env=ENV, stdout=subprocess.PIPE, text=True, bufsize=1)
        self.thread = threading.Thread(target=self._read, daemon=True)
        self.thread.start()
        t0 = time.monotonic()
        while self.header is None:
            if self.proc.poll() is not None or time.monotonic() - t0 > 10:
                raise RuntimeError("the recorder gave no header (exit %s)" % self.proc.poll())
            time.sleep(0.01)

    def _read(self):
        for line in self.proc.stdout:
            f = line.split()
            with self.lock:
                if f and f[0] == "F" and len(f) in (8, 9):
                    self.frames.append((int(f[1]), int(f[3]), int(f[8]) if len(f) == 9 else -1))
                    self.detail.append(tuple(int(v) for v in f[1:]))
                elif f and f[0] == "H":
                    self.header = f[1:]
                elif f and f[0] == "D":
                    self.dumps.append(f[1])

    def snapshot(self):
        with self.lock:
            return list(self.frames)

    def last_change(self):
        with self.lock:
            for t, rows, _ in reversed(self.frames):
                if rows > 0:
                    return t
        return None

    def wait_quiet(self, quiet_ns, since_ns, cap_ns):
        """Block until no change for quiet_ns after since_ns, or cap_ns passed since since_ns. Returns True on quiet."""
        while True:
            now = time.monotonic_ns()
            last = self.last_change()
            ref = since_ns if last is None or last < since_ns else last
            if now - ref >= quiet_ns:
                return True
            if now - since_ns >= cap_ns:
                return False
            time.sleep(0.01)

    def boxes(self, region, masks):
        """Outlines for the dump: green is the watched region, red the masks, in the dump's own coordinates."""
        ox, oy = self.dump_rect[0], self.dump_rect[1]
        out = [((region[0] - ox, region[1] - oy, region[2], region[3]), (0, 255, 0))]
        out += [((m[0] - ox, m[1] - oy, m[2], m[3]), (255, 0, 0)) for m in masks]
        return out

    def dump(self, timeout=5):
        n = len(self.dumps)
        self.proc.send_signal(signal.SIGUSR1)
        t0 = time.monotonic()
        while len(self.dumps) == n and time.monotonic() - t0 < timeout:
            time.sleep(0.01)
        return self.dumps[-1] if len(self.dumps) > n else None

    def stop(self):
        self.proc.terminate()
        try:
            self.proc.wait(5)
        except subprocess.TimeoutExpired:
            self.proc.kill()


def build_recorder(workdir):
    out = subprocess.run([os.path.join(HERE, "flea-framecap-build"), workdir], capture_output=True, text=True)
    if out.returncode != 0:
        raise RuntimeError(out.stderr.strip())
    return out.stdout.strip()


# --------------------------------------------------------------------------------------------------------------
# Pictures: a recorder dump (P6) as a PNG, with the regions drawn on it, for the evidence a number stands on.
# --------------------------------------------------------------------------------------------------------------


def read_ppm(path):
    with open(path, "rb") as f:
        data = f.read()
    parts = data.split(b"\n", 3)
    w, h = (int(v) for v in parts[1].split())
    return w, h, bytearray(parts[3])


def draw_box(buf, w, h, rect, rgb, thick=3):
    """An outline of rect (x, y, rw, rh) in region coordinates onto an RGB buffer."""
    x, y, rw, rh = rect
    for t in range(thick):
        for xx in range(max(0, x), min(w, x + rw)):
            for yy in (y + t, y + rh - 1 - t):
                if 0 <= yy < h:
                    i = (yy * w + xx) * 3
                    buf[i:i + 3] = bytes(rgb)
        for yy in range(max(0, y), min(h, y + rh)):
            for xx in (x + t, x + rw - 1 - t):
                if 0 <= xx < w:
                    i = (yy * w + xx) * 3
                    buf[i:i + 3] = bytes(rgb)


def write_png(path, w, h, buf):
    import zlib
    raw = bytearray()
    for y in range(h):
        raw.append(0)
        raw += buf[y * w * 3:(y + 1) * w * 3]

    def chunk(tag, body):
        c = struct.pack(">I", len(body)) + tag + body
        return c + struct.pack(">I", zlib.crc32(tag + body) & 0xFFFFFFFF)

    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
                + chunk(b"IDAT", zlib.compress(bytes(raw), 1)) + chunk(b"IEND", b""))


def ppm_to_png(ppm, png, boxes=()):
    """boxes: (rect relative to the dump, (r, g, b)) outlines, drawn so a reader sees what was watched."""
    w, h, buf = read_ppm(ppm)
    for rect, rgb in boxes:
        draw_box(buf, w, h, rect, rgb)
    write_png(png, w, h, buf)
    os.unlink(ppm)


