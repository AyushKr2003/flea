def calibrate_row(delay_ms, samples, swaps, floor, floor_share, frame_ms):
    # One delay row scored under both rules; the pass flag follows the client swap rule.
    err = [s - floor - delay_ms for s in samples]
    cerr = [(s - c) - floor_share for s, c in zip(samples, swaps)]
    return {"delay_ms": delay_ms,
            "error_vs_programmed_ms": [round(e, 1) for e in err],
            "error_vs_client_ms": [round(e, 1) for e in cerr],
            "worst_abs_error_ms": round(max(abs(e) for e in cerr), 1),
            "within_one_frame": all(abs(e) <= frame_ms for e in cerr)}


def calibrate(delays, runs, keep=None):
    """A client that changes its results a known delay after a key; the method must read that delay back."""
    work = tempfile.mkdtemp(prefix="flea-calib-")
    rec_bin = build_recorder(os.path.join(work, "rec"))
    cfg = os.path.join(work, "cfg")
    os.makedirs(cfg)
    with open(os.path.join(REPO, "tests", "search-calib.qml")) as f, open(os.path.join(cfg, "shell.qml"), "w") as g:
        g.write(f.read())
    keys = Keys()
    mon = monitor()
    frame_ms = 1000.0 / mon.get("refreshRate", 60.0)
    results = []
    for d in delays:
        samples = []
        swaps = []
        for run in range(runs):
            env = dict(ENV, CALIB_DELAY_MS=str(d), QT_FORCE_STDERR_LOGGING="1")
            logf = open(os.path.join(work, "client-%d-%d.log" % (d, run)), "w")
            client = subprocess.Popen(["qs", "-p", cfg, "-n"], env=env, stdout=logf, stderr=subprocess.STDOUT)
            try:
                win = window_by_pid({client.pid} | descendants(client.pid), 20)
                if win is None:
                    raise RuntimeError("the calibration window never mapped")
                focus_window(win["address"])
                park_cursor()
                time.sleep(1.0)
                win = [c for c in clients() if c["address"] == win["address"]][0]
                (x, y), (w, h) = win["at"], win["size"]
                # The query line is the top 48 px: the results region starts under it, and the line is masked besides.
                region = (x, y + 48, w, h - 48)
                masks = [(x, y, w, 48)]
                rec = Recorder(rec_bin, region, masks)
                time.sleep(0.6)
                t_key = keys.chord("a")
                ok = rec.wait_quiet(1 * NS, t_key, 6 * NS)
                frames = rec.snapshot()
                rec.stop()
                if os.environ.get("CALIB_DEBUG"):
                    print("DEBUG d=%d key=%d region=%s masks=%s" % (d, t_key, region, masks), file=sys.stderr)
                    for pres, recv, rows, first, last, c0, c1, ink in rec.detail:
                        print("DEBUG frame %+.1f ms rows=%d y %d..%d x %d..%d ink=%d recv_lag=%.1f" % (
                            (pres - t_key) / MS, rows, first, last, c0, c1, ink, (recv - pres) / MS), file=sys.stderr)
                t_first = first_change_after(result_changes_of(frames), t_key)
                if t_first is None:
                    raise RuntimeError("no result frame seen after the key (delay %d, run %d)" % (d, run))
                samples.append((t_first - t_key) / MS)
                logf.flush()
                with open(os.path.join(work, "client-%d-%d.log" % (d, run))) as f:
                    for line in f:
                        if "CALIB swap" in line:
                            kv = dict(p.split("=") for p in line.split("CALIB swap")[1].split())
                            swaps.append(float(kv["swapped"]) - float(kv["key"]))
            finally:
                client.terminate()
                try:
                    client.wait(5)
                except subprocess.TimeoutExpired:
                    client.kill()
                logf.close()
                time.sleep(0.5)
        results.append((d, samples, swaps))
    floor = statistics.median(results[0][1]) if results and results[0][0] == 0 else None
    # Median client share on the delay-0 row, the instrument floor under the new rule.
    floor_share = (statistics.median(s - c for s, c in zip(results[0][1], results[0][2]))
                   if results and results[0][0] == 0 and len(results[0][2]) == len(results[0][1]) else None)
    report = {"frame_ms": round(frame_ms, 2), "refresh_hz": mon.get("refreshRate"), "rows": []}
    for d, samples, swaps in results:
        row = {
            "delay_ms": d,
            "runs": len(samples),
            "measured_ms": [round(s, 1) for s in samples],
            "median_ms": round(statistics.median(samples), 1),
            "min_ms": round(min(samples), 1),
            "max_ms": round(max(samples), 1),
            "client_key_to_swap_ms": [round(s, 1) for s in swaps],
        }
        if floor is not None and floor_share is not None and len(swaps) == len(samples):
            row.update(calibrate_row(d, samples, swaps, floor, floor_share, frame_ms))
        report["rows"].append(row)
    report["floor_ms"] = None if floor is None else round(floor, 1)
    report["floor_share_ms"] = None if floor_share is None else round(floor_share, 1)
    report["workdir"] = work
    print(json.dumps(report, indent=1))
    return report


