def fixture_facts(path):
    """Entry count and depth of a fixture, walked once and recorded beside its numbers."""
    n = deepest = 0
    for cur, dirs, files in os.walk(path):
        rel = os.path.relpath(cur, path)
        depth = 0 if rel == "." else rel.count("/") + 1
        n += len(dirs) + len(files)
        deepest = max(deepest, depth + (1 if files else 0))
    return {"path": path, "entries": n, "max_depth": deepest}


def measure(plan_path):
    """measure PLAN.json: the JSON holds out (a .jsonl path), runs, query (and queries {fixture: query} where a fixture
    needs its own), mode, lengths, fixtures {name: dir}, arms.

    An arm is {"id", "entrant", "flea_dir"?, "view"?, "typing"?, "enter_baseline"?, "wl_debug"?, "fixtures"?}. Rounds
    interleave the arms and rotate their order, and every fixture is visited in every round."""
    with open(plan_path) as f:
        plan = json.load(f)
    out_path = plan["out"]
    out_dir = os.path.splitext(out_path)[0] + ".files"
    ctx = make_ctx(out_dir)
    arms = plan["arms"]
    UI_TOKENS[:] = [a["flea_dir"] + "/ui" for a in arms if a.get("flea_dir")]
    require_idle()
    for a in arms:
        if a["entrant"] not in ENTRANTS:
            raise SystemExit("plan names an entrant the table does not hold: " + a["entrant"])
    facts = {name: fixture_facts(path) for name, path in plan["fixtures"].items()}
    monitor_info = monitor()
    head = {"manifest": {
        "date": time.strftime("%Y-%m-%d %H:%M:%S"), "host": socket.gethostname(), "plan": plan, "fixtures": facts,
        "monitor": {k: monitor_info.get(k) for k in ("name", "width", "height", "refreshRate", "scale")},
        "entrants": {a["id"]: {"entrant": a["entrant"], "kind": ENTRANTS[a["entrant"]]["kind"], "filter_kind": ENTRANTS[a["entrant"]]["filter_kind"], "typing": a.get("typing", "")}
                     for a in arms},
        "recorder": ctx["rec_bin"], "pace_ms": plan.get("pace_ms", 180)}}
    n = len(arms)
    with open(out_path, "a") as out:
        out.write(json.dumps(head) + "\n")
        out.flush()
        for r in range(plan.get("runs", 5)):
            order = arms[r % n:] + arms[:r % n]
            for fixture_name, fixture in plan["fixtures"].items():
                for arm in order:
                    if arm.get("fixtures") and fixture_name not in arm["fixtures"]:
                        continue
                    opts = {"mode": plan.get("mode", "search"), "lengths": plan.get("lengths", [1, 3, 6]),
                            "pace_ms": plan.get("pace_ms", 180), "fixture_name": fixture_name,
                            "evidence": r == 0 and plan.get("evidence", True), "mem": r < 3, "tag": "r%d-%s" % (r, fixture_name),
                            "enter_baseline": bool(arm.get("enter_baseline"))}
                    try:
                        rows = run_arm(arm, fixture, plan.get("queries", {}).get(fixture_name, plan["query"]), ctx, opts)
                    except Exception as e:  # a failed run is a row, never a silent gap
                        rows = [{"arm": arm["id"], "error": "%s: %s" % (type(e).__name__, e)}]
                    for row in rows:
                        row.update({"round": r, "fixture": fixture_name, "arm": arm["id"]})
                        out.write(json.dumps(row) + "\n")
                        out.flush()
                    print("round %d %s %s: %s" % (r, fixture_name, arm["id"],
                                                  ", ".join("L%s first %s settled %s" % (x.get("length"), x.get("first_ms"), x.get("settled_ms"))
                                                            if "length" in x else x.get("error", "?") for x in rows)), flush=True)
    return 0


def rng(vals, digits=0):
    vals = [v for v in vals if v is not None]
    if not vals:
        return "n/a"
    return "%.*f [%.*f..%.*f]" % (digits, statistics.median(vals), digits, min(vals), digits, max(vals))


BAR_RATIO = 0.8  # the ratio check: a subject's median at or under 0.8 of Strata's, its slowest run faster than Strata's fastest


def median_of(vals):
    vals = [v for v in vals if v is not None]
    return statistics.median(vals) if vals else None


def clear_of(mine, theirs):
    """True when my slowest run is faster than their fastest, so the two ranges do not touch."""
    return bool(mine) and bool(theirs) and max(mine) < min(theirs)


def bar_of(mine, theirs):
    """Against one reference entrant, normally Strata: (ratio of medians, 'ok' or 'UNDER'), or (None, 'n/a')."""
    mine, theirs = [v for v in mine if v is not None], [v for v in theirs if v is not None]
    if not mine or not theirs or statistics.median(theirs) == 0:
        return None, "n/a"
    ratio = statistics.median(mine) / statistics.median(theirs)
    return ratio, "ok" if ratio <= BAR_RATIO and clear_of(mine, theirs) else "UNDER"


def status_vs(mine, theirs):
    """Against the next entrant: clear, OVERLAP (faster median, ranges touch) or NOT-FASTER (a tie is not faster)."""
    if not mine or not theirs:
        return "n/a"
    if statistics.median(mine) < statistics.median(theirs):
        return "clear" if clear_of(mine, theirs) else "OVERLAP"
    return "NOT-FASTER"


def subjects_of(manifest):
    """The arm ids the comparison tables treat as subjects: the plan's subjects, else every arm whose id starts with flea-stage."""
    plan = (manifest or {}).get("plan") or {}
    named = plan.get("subjects") or ([plan["subject"]] if plan.get("subject") else None)
    if named:
        return list(named)
    return [a for a in ((manifest or {}).get("entrants") or {}) if a.startswith("flea-stage")]


def verdict_lines(groups, manifest):
    """Comparison tables: per fixture, mode, length and time column, the subject's rank among the other entrants, its
    status against the next entrant and its ratio to Strata. An entrant counts when it shows results as you type (in
    filter mode, one whose filter narrows the rows); Flea's own older arms are shown as a baseline column instead."""
    ents = (manifest or {}).get("entrants") or {}
    subjects = subjects_of(manifest)
    strata = next((a for a, e in ents.items() if e.get("entrant") == "strata"), None)
    out = []
    for fixture in sorted({k[0] for k in groups}):
        for mode in sorted({k[1] for k in groups if k[0] == fixture}):
            rows = []
            for subject in subjects:
                for length in sorted({k[3] for k in groups if k[0] == fixture and k[1] == mode and k[2] == subject}):
                    for col in ("first_ms", "settled_ms"):
                        mine = [r[col] for r in groups.get((fixture, mode, subject, length), []) if r.get(col) is not None]
                        if not mine:
                            continue
                        others, baselines = {}, {}
                        for (fx, md, arm, ln), g in groups.items():
                            if (fx, md, ln) != (fixture, mode, length) or arm in subjects:
                                continue
                            e = ents.get(arm, {})
                            vals = [r[col] for r in g if r.get(col) is not None]
                            if not vals:
                                continue
                            if e.get("entrant") == "flea":
                                baselines[arm] = vals
                            elif e.get("typing", "") == "" and (mode != "filter" or "narrows" in e.get("filter_kind", "")):
                                others[arm] = vals
                        if not others:
                            rows.append("| %s | %s | %d | %s | %s | %s | n/a | n/a | n/a | no other entrant | n/a | n/a | n/a |" % (
                                fixture, mode, length, col, subject, rng(mine)))
                            continue
                        runner = min(others, key=lambda a: statistics.median(others[a]))
                        rank = 1 + sum(1 for v in others.values() if statistics.median(v) < statistics.median(mine))
                        ratio, bar = bar_of(mine, others.get(strata, [])) if strata else (None, "n/a")
                        base = ""
                        if baselines:
                            b = min(baselines, key=lambda a: statistics.median(baselines[a]))
                            base = "%s %.2f" % (b, statistics.median(mine) / statistics.median(baselines[b])) if statistics.median(baselines[b]) else b
                        rows.append("| %s | %s | %d | %s | %s | %s | %s | %s | %d of %d | %s | %s | %s | %s |" % (
                            fixture, mode, length, col, subject, rng(mine), runner, rng(others[runner]), rank, len(others) + 1,
                            status_vs(mine, others[runner]), "n/a" if ratio is None else "%.2f" % ratio, bar, base or "n/a"))
            if rows:
                out.append("### comparison, %s, %s (ms, median [min..max]; ok = ratio at most %.1f and slowest run faster than Strata's fastest)" % (fixture, mode, BAR_RATIO))
                out.append("")
                out.append("| fixture | mode | L | column | subject | subject ms | next | next ms | rank | vs next | x Strata | ratio check | x own baseline |")
                out.append("|---|---|---|---|---|---|---|---|---|---|---|---|---|")
                out.extend(rows)
                out.append("")
    return out


def report(path):
    """Markdown tables of median [min..max] per arm, fixture and length, and the self-pair spread of a/b arms."""
    rows = []
    manifest = None
    with open(path) as f:
        for line in f:
            d = json.loads(line)
            if "manifest" in d:
                manifest = d["manifest"]
            else:
                rows.append(d)
    groups = {}
    for r in rows:
        if "length" not in r:
            continue
        groups.setdefault((r["fixture"], r.get("mode", "search"), r["arm"], r["length"]), []).append(r)
    # A type-ahead find popup closes itself after a quiet spell, so its "settled" is the popup's timeout and says
    # nothing about the entrant: its settled column is withheld, not shown.
    popup = {k for k, v in ((manifest or {}).get("entrants") or {}).items() if v.get("filter_kind", "").startswith("type-ahead")}
    out = []
    ents = (manifest or {}).get("entrants") or {}
    subjects = subjects_of(manifest)
    strata = next((a for a, e in ents.items() if e.get("entrant") == "strata"), None)

    def strata_ratio(key, col):
        """Median of this row over Strata's median in the same fixture, mode and length, and the bar for a subject."""
        if strata is None or key[2] == strata:
            return "-"
        mine = [r.get(col) for r in groups[key]]
        theirs = [r.get(col) for r in groups.get((key[0], key[1], strata, key[3]), [])]
        ratio, bar = bar_of(mine, theirs)
        if ratio is None:
            return "n/a"
        return "%.2f %s" % (ratio, bar) if key[2] in subjects else "%.2f" % ratio

    for fixture in sorted({k[0] for k in groups}):
        for mode in sorted({k[1] for k in groups if k[0] == fixture}):
            out.append("### %s, %s" % (fixture, mode))
            out.append("")
            out.append("| arm | L | runs | first ms | settled ms | x Strata first | x Strata settled | capped | blank frames skipped | cpu s | enter first ms | enter settled ms |")
            out.append("|---|---|---|---|---|---|---|---|---|---|---|---|")
            for key in sorted(k for k in groups if k[0] == fixture and k[1] == mode):
                g = groups[key]
                withheld = key[1] == "filter" and key[2] in popup
                settled = "popup timeout" if withheld else rng([r.get("settled_ms") for r in g])
                out.append("| %s | %d | %d | %s | %s | %s | %s | %d | %d | %s | %s | %s |" % (
                    key[2], key[3], len(g), rng([r.get("first_ms") for r in g]), settled,
                    strata_ratio(key, "first_ms"), "n/a" if withheld else strata_ratio(key, "settled_ms"),
                    sum(1 for r in g if r.get("capped")), sum(r.get("blank_frames_skipped") or 0 for r in g),
                    rng([r.get("cpu_search_s") for r in g], 2),
                    rng([r.get("enter_first_ms") for r in g]), rng([r.get("enter_settled_ms") for r in g])))
            out.append("")
            arms = sorted({k[2] for k in groups if k[0] == fixture and k[1] == mode})
            pairs = [(a, a[:-2] + "-b") for a in arms if a.endswith("-a") and a[:-2] + "-b" in arms]
            for a, b in pairs:
                for length in sorted({k[3] for k in groups if k[2] == a}):
                    ga, gb = groups.get((fixture, mode, a, length), []), groups.get((fixture, mode, b, length), [])
                    for col in ("first_ms", "settled_ms"):
                        va = [r[col] for r in ga if r.get(col) is not None]
                        vb = [r[col] for r in gb if r.get(col) is not None]
                        if va and vb:
                            out.append("self-pair %s vs %s L%d %s: medians %.0f and %.0f, spread %.0f ms" % (
                                a, b, length, col, statistics.median(va), statistics.median(vb),
                                abs(statistics.median(va) - statistics.median(vb))))
            out.append("")
    out.extend(verdict_lines(groups, manifest))
    mem_rows = [r for r in rows if "mem_settled" in r]
    if mem_rows:
        out.append("### memory of the entrant's process tree, kB, median [min..max], at settled results and 3 s after Esc")
        out.append("")
        out.append("| fixture | mode | arm | runs | Pss settled | Pss x Strata | Pss_Anon settled | USS settled | Pss after Esc | USS after Esc | processes |")
        out.append("|---|---|---|---|---|---|---|---|---|---|---|")
        by = {}
        for r in mem_rows:
            by.setdefault((r["fixture"], r.get("mode", "search"), r["arm"] + (" (typed)" if "mem_enter_settled" in r else ""),
                           "mem_settled"), []).append(r)
            if "mem_enter_settled" in r:
                by.setdefault((r["fixture"], r.get("mode", "search"), r["arm"] + " (Enter)", "mem_enter_settled"), []).append(r)
        for key in sorted(by):
            g = by[key]
            after = [r.get("mem_after_close") or {} for r in g]
            theirs = [r["mem_settled"]["pss_kb"] for r in by.get((key[0], key[1], strata, "mem_settled"), [])] if strata else []
            ratio, bar = bar_of([r[key[3]]["pss_kb"] for r in g], theirs)
            versus = "-" if key[2] == strata else "n/a" if ratio is None else "%.2f %s" % (ratio, bar) if key[2].split(" ")[0] in subjects else "%.2f" % ratio
            out.append("| %s | %s | %s | %d | %s | %s | %s | %s | %s | %s | %s |" % (
                key[0], key[1], key[2], len(g), rng([r[key[3]]["pss_kb"] for r in g]), versus,
                rng([r[key[3]]["pss_anon_kb"] for r in g]), rng([r[key[3]]["uss_kb"] for r in g]),
                rng([a.get("pss_kb") for a in after]), rng([a.get("uss_kb") for a in after]),
                ",".join(sorted({p["comm"] for p in g[0][key[3]]["procs"]}))))
        out.append("")
    gap_rows = [r for r in rows if r.get("frame_gaps") or r.get("enter_frame_gaps")]
    if gap_rows:
        out.append("### attach gaps of the busiest surface, ms: first keystroke to settled, and Enter to settled")
        out.append("")
        out.append("| fixture | mode | arm | L | window | attaches | largest | p95 |")
        out.append("|---|---|---|---|---|---|---|---|")
        for r in gap_rows:
            for label, key in (("typing", "frame_gaps"), ("Enter", "enter_frame_gaps")):
                g = r.get(key)
                if g:
                    out.append("| %s | %s | %s | %d | %s | %d | %s | %s |" % (
                        r["fixture"], r.get("mode", "search"), r["arm"], r["length"], label, g["attaches"],
                        g["max_gap_ms"], g["p95_gap_ms"]))
        out.append("")
    errors = [r for r in rows if "error" in r]
    if errors:
        out.append("errors: " + "; ".join("%s r%s: %s" % (e.get("arm"), e.get("round"), e["error"]) for e in errors))
    print("\n".join(out))
    return 0


def is_subsequence(q, text):
    it = iter(text)
    return all(c in it for c in q)


def pickquery(root, flat=False):
    """The fixed 6 character query of a column, recorded with what it matches.

    A tree: the 6-gram of lower case letters and digits that sits in base names at the most depths (at least three,
    taking the most frequent of them), so it has plain substring matches at several depths, and the subsequence matches
    over relative paths come out beside it. A flat folder: a 6 character substring of a name inside the first rows Flea's
    "/" filter holds (it narrows the held window, not the whole folder) that changes the rows on screen at 1, 3 and 6
    characters, so no column reads "no change" for a narrowing that left the visible rows as they were."""
    if flat:
        # Flea's "/" filter narrows the rows its list holds, the first 350 of a long folder, and says so ("0 of 321
        # shown, of 10,000 in this folder"), so a query is picked from names inside that window: a query with no match
        # there ends a column on "Nothing matched", which the first box run showed.
        names = sorted(os.listdir(root), key=str.lower)
        held = names[:HELD_ROWS]
        def top(q):
            return [n for n in held if q in n.lower()][:VISIBLE_ROWS]
        # A substring of a name, so the match moves the rows: a name's own prefix leaves the head of a sorted list as it was.
        grams = []
        for n in held[len(held) // 3:] + held[:len(held) // 3]:
            low = n.lower()
            for i in range(1, len(low) - 5):
                g = low[i:i + 6]
                if g not in grams and re.fullmatch(r"[a-z0-9._-]{6}", g):
                    grams.append(g)
        for pick in grams:
            # The picture must differ from key to key, or a column reads "no change" for a narrowing it never drew: the
            # rows on screen after 0, 1, 3 and 6 characters are four different lists, the last of them not empty.
            tops = [top(pick[:k]) for k in (0, 1, 3, 6)]
            if all(tops[i] != tops[i + 1] for i in range(3)) and len(tops[3]) >= 3:
                break
        else:
            raise SystemExit("no 6 character substring changes the visible rows at 1, 3 and 6 characters in the first %d rows of %s" % (HELD_ROWS, root))

        def within(rows, q):
            return sum(1 for n in rows if q in n.lower())
        return {"query": pick, "entries": len(names), "held_rows": len(held),
                "held_after_1": within(held, pick[:1]), "held_after_3": within(held, pick[:3]),
                "held_matches": within(held, pick),
                "substring_matches": within(names, pick),
                "subsequence_matches": sum(1 for n in names if is_subsequence(pick, n.lower())),
                "after_1": within(names, pick[:1]), "after_3": within(names, pick[:3])}
    depth_of, count, rels = {}, {}, []
    for cur, dirs, files in os.walk(root):
        rel = os.path.relpath(cur, root)
        depth = 0 if rel == "." else rel.count("/") + 1
        for name in dirs + files:
            rels.append(os.path.join(rel, name).lstrip("./").lower() if rel != "." else name.lower())
            low = name.lower()
            for m in {low[i:i + 6] for i in range(len(low) - 5)}:
                if re.fullmatch(r"[a-z0-9]{6}", m):
                    depth_of.setdefault(m, set()).add(depth)
                    count[m] = count.get(m, 0) + 1
    cands = [g for g, d in depth_of.items() if len(d) >= 3 and 20 <= count[g] <= 2000]
    if not cands:
        raise SystemExit("no 6-gram sits at three depths with 20 to 2000 substring matches under " + root)
    best = max(cands, key=lambda g: (len(depth_of[g]), count[g], g))
    return {"query": best, "entries": len(rels), "depths": sorted(depth_of[best]), "substring_matches": count[best],
            "subsequence_matches": sum(1 for r in rels if is_subsequence(best, r)),
            "after_1": sum(1 for r in rels if best[:1] in r), "after_3": sum(1 for r in rels if best[:3] in r)}


