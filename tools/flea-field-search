def selftest():
    fail = []

    def check(name, got, want):
        if got != want:
            fail.append("%s: got %r, wanted %r" % (name, got, want))

    ms = MS
    frames = [(t * ms, rows) for t, rows in [(0, -1), (100, 0), (250, 12), (258, 3), (900, 0), (3000, 0)]]
    cols = search_columns(frames, [200 * ms], 5000 * ms)
    check("first", cols["first_ms"], 50.0)
    check("settled", cols["settled_ms"], 58.0)
    check("capped", cols["capped"], False)
    # A change that lands after the next key belongs to the next key.
    frames = [(t * ms, rows) for t, rows in [(0, -1), (500, 5), (700, 5)]]
    cols = search_columns(frames, [100 * ms, 400 * ms], 5000 * ms)
    check("per_key_late", cols["per_key_first_ms"], [None, 100.0])
    check("per_key_first_final", cols["first_ms"], 100.0)
    # No change at all.
    cols = search_columns([(0, -1), (9 * ms, 0)], [100 * ms], 5000 * ms)
    check("none_first", cols["first_ms"], None)
    check("none_settled", cols["settled_ms"], None)
    # Still changing at the cap: reported at the cap and flagged.
    frames = [(t * ms, 3) for t in range(1000, 40000, 500)]
    cols = search_columns(frames, [500 * ms], 40000 * ms)
    check("cap_settled", cols["settled_ms"], 15000.0)
    check("cap_flag", cols["capped"], True)
    # A recording that ends before the quiet gap is complete is not a settle.
    frames = [(1000 * ms, 4), (1500 * ms, 4)]
    cols = search_columns(frames, [500 * ms], 2000 * ms)
    check("short_flag", cols["capped"], True)
    # Rows still changing right before the final key are flagged.
    frames = [(480 * ms, 8), (700 * ms, 8)]
    cols = search_columns(frames, [500 * ms], 6000 * ms)
    check("busy", cols["busy_at_final_key"], True)
    # Frame times compare strictly: a frame presented at the key's own instant is not a result of it.
    check("strict", first_change_after([500 * ms], 500 * ms), None)
    # Frame gaps: attaches 10 ms apart with one 80 ms hole, between a key and the end of the search.
    lines = ["[%d.000]  -> wl_surface@23.attach(wl_buffer@41, 0, 0)" % t for t in (1000, 1010, 1020, 1100, 1110)]
    lines += ["[1050.000]  -> wl_surface@99.attach(wl_buffer@7, 0, 0)", "[1005.000]  <- wl_surface@23.enter(wl_output@3)",
              "[999.000]  -> wl_surface@23.attach(wl_buffer@40, 0, 0)"]
    g = attach_gaps(lines, 1000 * 1e6, 1120 * 1e6)
    check("gap_attaches", g["attaches"], 5)
    check("gap_max", g["max_gap_ms"], 80.0)
    check("gap_none", attach_gaps(lines, 5000 * 1e6, 6000 * 1e6), None)
    # The time-of-day form, in UTC and in the local zone, around a run that started at monotonic 7000 ms.
    off = 1_700_000_000 * NS - 7000 * MS  # realtime minus monotonic
    for zone in (0, time.localtime().tm_gmtoff * NS):
        stamps = []
        for t_ms in (7000, 7010, 7020, 7100, 7110):
            real = 1_700_000_000 * NS + (t_ms - 7000) * MS + zone
            sod = real % (86400 * NS)
            stamps.append("[%02d:%02d:%09.6f] {mesa vk display queue}  -> wl_surface#37.attach(wl_buffer#81, 0, 0)" % (
                sod // (3600 * NS), sod // (60 * NS) % 60, sod % (60 * NS) / NS))
        g = attach_gaps(stamps, 7000 * MS, 7120 * MS, off)
        check("gap_tod_attaches", g and g["attaches"], 5)
        check("gap_tod_max", g and g["max_gap_ms"], 80.0)
    # A query may hold any of a-z, 0-9, dot, dash and underscore, and each must reach the input path.
    check("typeable", all(c in KEYCODES or c in SHIFTED and SHIFTED[c] in KEYCODES for c in "abcdefghijklmnopqrstuvwxyz0123456789.-_"), True)
    # The entrant table: every chord names keys the input path knows, and every entrant has a launch line.
    for name, spec in ENTRANTS.items():
        for chords in (spec["open"], spec["close"], spec["filter_open"], spec["filter_close"]):
            for chord in chords:
                for k in chord:
                    check("key %s in %s" % (k, name), k in KEYCODES, True)
        check("region %s" % name, len(spec["region"](2536, 1386)), 4)
        check("filter region %s" % name, len(spec.get("filter_region", spec["region"])(2536, 1386)), 4)
    # report: a self-pair of a and b arms reads its spread off the medians.
    import io
    from contextlib import redirect_stdout
    with tempfile.NamedTemporaryFile("w", suffix=".jsonl", delete=False) as tf:
        for arm, vals in (("x-a", (10, 12, 14)), ("x-b", (20, 22, 24))):
            for i, v in enumerate(vals):
                tf.write(json.dumps({"arm": arm, "fixture": "local", "mode": "search", "length": 3, "first_ms": v,
                                     "settled_ms": v * 2, "capped": False, "cpu_search_s": 0.5, "round": i}) + "\n")
        tf.write(json.dumps({"arm": "x-a", "fixture": "local", "mode": "search", "length": 6, "first_ms": 5,
                             "settled_ms": 9, "capped": False, "round": 0,
                             "mem_settled": {"pss_kb": 900, "pss_anon_kb": 700, "uss_kb": 800, "procs": [{"comm": "qs"}]},
                             "mem_after_close": {"pss_kb": 500, "uss_kb": 400},
                             "frame_gaps": {"attaches": 9, "max_gap_ms": 31.5, "p95_gap_ms": 17.0},
                             "enter_frame_gaps": {"attaches": 4, "max_gap_ms": 20.0, "p95_gap_ms": 20.0}}) + "\n")
        tf.write(json.dumps({"manifest": {"entrants": {"t": {"filter_kind": "type-ahead find (GTK): selects a row"}}}}) + "\n")
        tf.write(json.dumps({"arm": "t", "fixture": "flat", "mode": "filter", "length": 3, "first_ms": 7, "settled_ms": 5000,
                             "capped": False, "round": 0}) + "\n")
    buf = io.StringIO()
    with redirect_stdout(buf):
        report(tf.name)
    os.unlink(tf.name)
    check("report_median", "12 [10..14]" in buf.getvalue(), True)
    check("report_pair", "spread 10 ms" in buf.getvalue(), True)
    check("report_mem", "| local | search | x-a | 1 | 900 [900..900] | n/a | 700 [700..700] | 800 [800..800] | 500 [500..500] | 400 [400..400] | qs |" in buf.getvalue(), True)
    check("report_gaps", "| local | search | x-a | 6 | typing | 9 | 31.5 | 17.0 |" in buf.getvalue(), True)
    check("report_enter_gaps", "| local | search | x-a | 6 | Enter | 4 | 20.0 | 20.0 |" in buf.getvalue(), True)
    check("report_popup", "popup timeout" in buf.getvalue(), True)
    # The comparison: a subject against the next entrant and Strata, one case each of clear, OVERLAP, NOT-FASTER, ok and UNDER.
    check("bar_ok", bar_of([30, 31, 32], [50, 60, 70]), (31 / 60, "ok"))
    check("bar_ratio_only", bar_of([48, 49, 50], [55, 60, 70])[1], "UNDER")  # ratio 0.82 is over 0.8
    check("bar_overlap", bar_of([30, 31, 62], [50, 60, 70])[1], "UNDER")  # ratio ok, slowest run not under Strata's fastest
    check("status_clear", status_vs([10, 11, 12], [13, 14, 15]), "clear")
    check("status_overlap", status_vs([10, 11, 14], [13, 14, 15]), "OVERLAP")
    check("status_tie", status_vs([10, 12, 14], [10, 12, 14]), "NOT-FASTER")
    check("status_loss", status_vs([20, 21, 22], [13, 14, 15]), "NOT-FASTER")
    with tempfile.NamedTemporaryFile("w", suffix=".jsonl", delete=False) as tf:
        tf.write(json.dumps({"manifest": {"plan": {"subjects": ["flea-stage"]}, "entrants": {
            "flea-stage": {"entrant": "flea", "typing": ""}, "flea-038-a": {"entrant": "flea", "typing": "highlight only"},
            "strata": {"entrant": "strata", "typing": ""}, "thunar": {"entrant": "thunar", "typing": ""}}}}) + "\n")
        for arm, vals in (("flea-stage", (10, 11, 12)), ("strata", (30, 31, 32)), ("thunar", (11, 15, 41)),
                          ("flea-038-a", (50, 51, 52))):
            for i, v in enumerate(vals):
                tf.write(json.dumps({"arm": arm, "fixture": "local", "mode": "search", "length": 1, "first_ms": v,
                                     "settled_ms": v + 5, "capped": False, "round": i}) + "\n")
    buf = io.StringIO()
    with redirect_stdout(buf):
        report(tf.name)
    os.unlink(tf.name)
    text = buf.getvalue()
    check("verdict_overlap", "| local | search | 1 | first_ms | flea-stage | 11 [10..12] | thunar | 15 [11..41] | 1 of 3 | OVERLAP | 0.35 | ok | flea-038-a 0.22 |" in text, True)
    check("verdict_strata_col", "| flea-stage | 1 | 3 | 11 [10..12] | 16 [15..17] | 0.35 ok | 0.44 ok |" in text, True)
    # A blank frame after the key is a change but no result: the first result is the first frame with ink rows.
    frames = [(0, -1, -1), (250 * ms, 12, 2), (270 * ms, 12, 40), (900 * ms, 0, -1)]
    cols = search_columns(frames, [200 * ms], 5000 * ms)
    check("ink_first", cols["first_ms"], 70.0)
    check("ink_blank_skipped", cols["blank_frames_skipped"], 1)
    check("ink_settled", cols["settled_ms"], 70.0)
    check("ink_old_log", search_columns([(250 * ms, 12)], [200 * ms], 5000 * ms)["first_ms"], 50.0)
    if fail:
        print("\n".join("FAIL " + f for f in fail))
        return 1
    print("SELFTEST ok")
    return 0


def make_ctx(out_dir, flea_dir=None):
    os.makedirs(out_dir, exist_ok=True)
    ctx = {"out_dir": out_dir, "keys": Keys()}
    ctx["rec_bin"] = build_recorder(os.path.join(out_dir, "rec"))
    ctx["tui_conf"] = tempfile.mkdtemp(prefix="flea-tuiconf-")
    subprocess.run(["cp", "-r", os.path.join(HERE, "flea-bench-tui") + "/.", ctx["tui_conf"]], check=True)
    # broot asks once, on a first run, to install its shell function, and that prompt swallows every key. The marker is
    # the file it writes when answered, so the harness config starts past the question and no key of the bench is spent.
    os.makedirs(ctx["tui_conf"] + "/broot/launcher", exist_ok=True)
    open(ctx["tui_conf"] + "/broot/launcher/installed-v1", "w").close()
    ctx["states"] = {}
    return ctx


def explore(argv):
    """explore ENTRANT DIR QUERY [--flea TREE] [--filter] [--enter] [--out DIR] [--json FILE]: one run with evidence.

    Rows go to FILE as JSON when --json is given, so a caller never reads them through a truncated tail."""
    ent, fixture, query = argv[0], argv[1], argv[2]
    flea = argv[argv.index("--flea") + 1] if "--flea" in argv else None
    out = argv[argv.index("--out") + 1] if "--out" in argv else tempfile.mkdtemp(prefix="flea-explore-")
    ctx = make_ctx(out, flea)
    arm = {"id": ent + ("-" + os.path.basename(flea) if flea else ""), "entrant": ent, "flea_dir": flea}
    if flea:
        UI_TOKENS.append(flea + "/ui")
    opts = {"evidence": True, "fixture_name": "explore", "mode": "filter" if "--filter" in argv else "search",
            "enter_baseline": "--enter" in argv, "tag": "x"}
    rows = run_arm(arm, fixture, query, ctx, opts)
    for r in rows:
        r.pop("key_times_ns", None)
    text = json.dumps(rows, indent=1)
    if "--json" in argv:
        with open(argv[argv.index("--json") + 1], "w") as f:
            f.write(text + "\n")
    else:
        print(text)
    return 0


PREFLIGHT_TOOLS = ("qs", "hyprctl", "gcc", "wayland-scanner", "strace", "ffmpeg", "kitty", "nautilus", "thunar", "nemo",
                   "dolphin", "yazi", "pcmanfm", "broot", "grim", "ydotool")
PREFLIGHT_XML = ("ext-image-capture-source/ext-image-capture-source-v1", "ext-image-copy-capture/ext-image-copy-capture-v1",
                 "ext-foreign-toplevel-list/ext-foreign-toplevel-list-v1")


def preflight():
    """One line per need, `ok` or `MISSING`, so a lane can name the gaps before it books a window on them."""
    import shutil
    missing = 0
    for tool in PREFLIGHT_TOOLS:
        path = shutil.which(tool)
        print("%-8s %-18s %s" % ("ok" if path else "MISSING", tool, path or ""))
        missing += 0 if path else 1
    base = os.environ.get("WAYLAND_PROTOCOLS", "/usr/share/wayland-protocols") + "/staging/"
    for x in PREFLIGHT_XML:
        have = os.access(base + x + ".xml", os.R_OK)
        print("%-8s %-18s %s" % ("ok" if have else "MISSING", "protocol xml", base + x + ".xml"))
        missing += 0 if have else 1
    # Strata is the v0.21.0 build, found by path (never by PATH) and by its crate's version.
    sbin = strata_bin()
    manifest = os.path.join(os.path.dirname(sbin), "..", "..", "Cargo.toml")
    version = ""
    if os.path.exists(manifest):
        with open(manifest) as f:
            for line in f:
                if line.startswith("version"):
                    version = line.split("=")[1].strip().strip('"')
                    break
    good = os.access(sbin, os.X_OK) and version.startswith("0.21.")
    print("%-8s %-18s %s (crate version %s)" % ("ok" if good else "MISSING", "strata v0.21", sbin, version or "unknown"))
    missing += 0 if good else 1
    sock = os.environ.get("YDOTOOL_SOCKET") or os.path.join(os.environ.get("XDG_RUNTIME_DIR", ""), ".ydotool_socket")
    print("%-8s %-18s %s" % ("ok" if os.path.exists(sock) else "MISSING", "ydotool socket", sock))
    missing += 0 if os.path.exists(sock) else 1
    return 0 if not missing else 1


def main(argv):
    global ENV
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd = argv[0]
    if cmd == "pickquery":
        print(json.dumps(pickquery(argv[1], "--flat" in argv)))
        return 0
    if cmd == "preflight":
        return preflight()
    if cmd in ("selftest", "report"):
        return selftest() if cmd == "selftest" else report(argv[1])
    ENV = session_env()
    os.environ.update(ENV)
    if cmd == "measure":
        return measure(argv[1])
    if cmd == "explore":
        return explore(argv[1:])
    if cmd == "calibrate":
        delays, runs = [0, 50, 200], 10
        rest = argv[1:]
        while rest:
            if rest[0] == "--delays":
                delays = [int(v) for v in rest[1].split(",")]
            elif rest[0] == "--runs":
                runs = int(rest[1])
            else:
                print("unknown option " + rest[0], file=sys.stderr)
                return 2
            rest = rest[2:]
        rep = calibrate(delays, runs)
        ok = all(r.get("within_one_frame", False) for r in rep["rows"])
        return 0 if ok else 1
    print("unknown command " + cmd, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
