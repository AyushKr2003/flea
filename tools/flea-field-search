# comm, cmdline token: the same table as tools/flea-field-bench's KILL_TARGETS, so a run ends what the bench would end
# and nothing else. A bare qs is never matched: a token naming a Flea tree's ui directory picks Flea's own.
KILL_TARGETS = [("qs", "/ui"), ("flea", "--backend"), ("kitty", "--class " + TUI_CLASS), ("nautilus", ""),
                ("org.gnome.Nauti", ""), ("thunar", ""), ("tumblerd", ""), ("pcmanfm", ""), ("nemo", ""),
                ("dolphin", ""), ("strata", ""), ("yazi", ""), ("broot", ""), ("fzf", ""), ("localsearch-3", ""),
                ("localsearch-ext", ""), ("hyprland-dialog", "")]


def pids_for(comm, token=""):
    out = []
    for p in subprocess.run(["pgrep", "-x", comm], capture_output=True, text=True).stdout.split():
        try:
            with open("/proc/%s/cmdline" % p) as f:
                cmd = f.read().replace("\0", " ")
        except OSError:
            continue
        if not token or token in cmd:
            out.append(int(p))
    return out


# The ui directories of the Flea trees this run launches; qs is matched by them and never bare.
UI_TOKENS = []


def alive_targets():
    out = []
    for c, t in KILL_TARGETS:
        if c == "qs":
            out += [(c, p) for tok in UI_TOKENS for p in pids_for(c, tok)]
        else:
            out += [(c, p) for p in pids_for(c, t)]
    return out


