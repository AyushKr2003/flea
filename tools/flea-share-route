#!/usr/bin/env bash
# Times one share opened through two routes, the kernel mount and the GVFS FUSE path, each in a fresh Flea, interleaved so drift hits both.
# Usage: flea-share-route KERNEL_PATH GVFS_PATH [RUNS]   (RUNS defaults to 9); flea-share-route --dry-run [RUNS] proves the script on stubs.
# Env: FLEA_BIN (default target/release/flea), FLEA_UI (default ui), PRE_RUN (a shell line run before every launch, for dropping caches),
#      LISTED_TIMEOUT_MS (default 60000, a launch deadline and never a retry), OUT (CSV path, default under the run's sandbox).
# Output, the field bench's shape: a CSV header then one row per run, then "median [min..max]" per route and the ratio.
# Sample row: "kernel,1,412,305,260" is route, run, listed_ms (exec to a settled listing), first_rows_ms (exec to the first row), rows.
# The clock is polled over ipc, so listed_ms resolves to one call (tens of ms) and both routes carry the same cost.
# On minipc, with the kernel mount at /mnt/nas and the same share at /run/user/1000/gvfs/smb-share:server=nas,share=isos:
#   tools/flea-share-route /mnt/nas/isos "/run/user/1000/gvfs/smb-share:server=nas,share=isos" 9
set -uo pipefail
. "$(dirname "$0")/flea-sandbox-guard"
repo=$(cd "$(dirname "$0")/.." && pwd)
. "$repo/tools/flea-ipc-pid"

dry=no
if [ "${1:-}" = --dry-run ]; then dry=yes; shift; fi
runs=${3:-9}
[ "$dry" = yes ] && runs=${1:-3}
[[ "$runs" =~ ^[1-9][0-9]*$ ]] || { echo "flea-share-route: RUNS must be a positive integer" >&2; exit 2; }
FLEA_BIN=${FLEA_BIN:-$repo/target/release/flea}
FLEA_UI=${FLEA_UI:-$repo/ui}
LISTED_TIMEOUT_MS=${LISTED_TIMEOUT_MS:-60000}

# A marked sandbox of its own holds the per-run state, the CSV and the dry run's fixtures; cleanup deletes only that.
root=$(mktemp -d "$FIXTURE_ROOT/flea-share-route-XXXXXX") || exit 1
case $root in /*/*) ;; *) echo "flea-share-route: mktemp gave '$root'" >&2; exit 1 ;; esac
sandbox_require "$root" || exit 1
: > "$root/$SANDBOX_MARKER" || exit 1
flea_pid=""
stop_flea() {
  local qpid
  qpid=$(flea_ipc_pid "$FLEA_UI" 2>/dev/null) || qpid=""
  [ -n "$flea_pid" ] && kill "$flea_pid" 2>/dev/null
  [ -n "$qpid" ] && kill "$qpid" 2>/dev/null
  [ -n "$qpid" ] && timeout 10 tail --pid="$qpid" -f /dev/null
  [ -n "$flea_pid" ] && wait "$flea_pid" 2>/dev/null
  flea_pid=""
}
cleanup() { stop_flea; sandbox_remove "$root"; }
trap cleanup EXIT

if [ "$dry" = yes ]; then
  # Dry run: two local folders, a stub flea and a stub qs that settle a folder after the milliseconds its .delay names (kernel 120, gvfs 340).
  kernel_path=$root/kernel gvfs_path=$root/gvfs
  mkdir "$root/kernel" "$root/gvfs" "$root/stub" "$root/ui" "$root/ui/boot" || exit 1
  echo 120 > "$root/kernel/.delay"; echo 340 > "$root/gvfs/.delay"
  for i in 1 2 3 4 5; do : > "$root/kernel/f$i.txt"; : > "$root/gvfs/f$i.txt"; done
  printf '#!/bin/bash\necho "$2" > %q/cur.path; date +%%s%%3N > %q/cur.t0; echo $$ > %q/cur.pid; exec sleep 600\n' "$root/stub" "$root/stub" "$root/stub" > "$root/stub/flea"
  cat > "$root/stub/qs" <<EOS
#!/bin/bash
d=$root/stub
pid=\$(cat \$d/cur.pid 2>/dev/null)
if [ "\$1" = list ]; then
  [ -n "\$pid" ] && kill -0 "\$pid" 2>/dev/null && printf 'Instance x:\n  Process ID: %s\n  Shell ID: flea\n  Config path: $root/ui/boot/shell.qml\n' "\$pid"
  exit 0
fi
path=\$(cat \$d/cur.path); t0=\$(cat \$d/cur.t0); delay=\$(cat "\$path/.delay"); up=\$(( \$(date +%s%3N) - t0 >= delay ))
case \$6 in
  path) echo "\$path" ;;
  state) [ "\$up" = 1 ] && echo ready || echo loading ;;
  listInFlight) [ "\$up" = 1 ] && echo false || echo true ;;
  total) echo 5 ;;
  firstRowsAt) echo \$(( t0 + delay / 2 )) ;;
esac
EOS
  chmod +x "$root/stub/flea" "$root/stub/qs"
  export PATH="$root/stub:$PATH" FLEA_BIN="$root/stub/flea" FLEA_UI="$root/ui"
else
  kernel_path=${1:?kernel mount path}
  gvfs_path=${2:?gvfs path}
  for p in "$kernel_path" "$gvfs_path"; do
    [ -d "$p" ] || { echo "flea-share-route: $p is not a directory" >&2; exit 2; }
  done
  [ -x "$FLEA_BIN" ] || { echo "flea-share-route: $FLEA_BIN is not executable" >&2; exit 2; }
  command -v qs >/dev/null || { echo "flea-share-route: qs is not installed" >&2; exit 2; }
fi

ipc() { timeout 2 qs ipc --pid "$qpid" call flea "$@" 2>/dev/null; }
now_ms() { date +%s%3N; }
out=${OUT:-$root/share-route.csv}
echo "route,run,listed_ms,first_rows_ms,rows" | tee "$out"

# One launch: the pane opens $2 in a fresh state dir, and listed_ms is the first poll that reads a settled listing at that path.
one_run() {
  local route=$1 path=$2 run=$3 t0 qpid="" listed=-1 first=-1 rows=-1 state flight where fr
  mkdir "$root/state-$route-$run" || return 1
  [ -z "${PRE_RUN:-}" ] || bash -c "$PRE_RUN" > /dev/null 2>&1 || { echo "flea-share-route: PRE_RUN failed" >&2; return 1; }
  t0=$(now_ms)
  XDG_STATE_HOME="$root/state-$route-$run" FLEA_UI="$FLEA_UI" FLEA_BIN="$FLEA_BIN" \
    setsid nohup "$FLEA_BIN" --gui "$path" > /dev/null 2>&1 < /dev/null &
  flea_pid=$!
  while [ $(( $(now_ms) - t0 )) -lt "$LISTED_TIMEOUT_MS" ]; do
    [ -n "$qpid" ] || { qpid=$(flea_ipc_pid "$FLEA_UI" 2>/dev/null) || { qpid=""; continue; }; }
    where=$(ipc path) || continue
    [ "$where" = "$path" ] || continue
    state=$(ipc state) || continue
    flight=$(ipc listInFlight) || continue
    if [ "$flight" = false ] && { [ "$state" = ready ] || [ "$state" = empty ]; }; then
      listed=$(( $(now_ms) - t0 ))
      rows=$(ipc total) || rows=-1
      fr=$(ipc firstRowsAt) && [ "$fr" -gt 0 ] 2>/dev/null && first=$(( ${fr%.*} - t0 ))
      break
    fi
  done
  printf '%s,%s,%s,%s,%s\n' "$route" "$run" "$listed" "$first" "$rows" | tee -a "$out"
  stop_flea
}

for run in $(seq 1 "$runs"); do
  one_run kernel "$kernel_path" "$run" || exit 1
  one_run gvfs "$gvfs_path" "$run" || exit 1
done

# Median and range of the settled listed_ms values per route, as "route median min max settled failed"; a -1 row never settled and is counted apart.
summary() {
  awk -F, -v r="$1" '
    $1 == r && $3 > 0 { v[n++] = $3 }
    $1 == r && $3 <= 0 { bad++ }
    END {
      if (n == 0) { printf "%s 0 0 0 0 %d\n", r, bad; exit }
      for (i = 1; i < n; i++) { x = v[i]; j = i - 1; while (j >= 0 && v[j] > x) { v[j + 1] = v[j]; j-- } v[j + 1] = x }
      m = (n % 2) ? v[(n - 1) / 2] : (v[n / 2 - 1] + v[n / 2]) / 2
      printf "%s %.0f %d %d %d %d\n", r, m, v[0], v[n - 1], n, bad
    }' "$out"
}
read -r _ km kmin kmax kn kbad <<< "$(summary kernel)"
read -r _ gm gmin gmax gn gbad <<< "$(summary gvfs)"
printf 'kernel: listed %s ms [%s..%s] over %s runs, %s failed\n' "$km" "$kmin" "$kmax" "$kn" "$kbad"
printf 'gvfs: listed %s ms [%s..%s] over %s runs, %s failed\n' "$gm" "$gmin" "$gmax" "$gn" "$gbad"
if [ "$kn" -eq 0 ] || [ "$gn" -eq 0 ]; then
  echo "kernel/gvfs: a route has no settled run"
  exit 1
fi
awk -v k="$km" -v g="$gm" 'BEGIN { printf "kernel/gvfs %.2f: the kernel route is %s\n", k / g, (k < g ? "faster" : "NOT faster") }'
