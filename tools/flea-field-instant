    check("rep_heavy", "| 5 | open.ql.pdf | list | local | 20 | 40.0 | 40.0 | 40.0 | 100 | 100 / 1000 | CEILING-OK |"
          in text, True)
    check("rep_noinst", "nav.list.fling list local: no instrument (why)" in text, True)
    check("rep_error", "error op.trash list : RuntimeError: x" in text, True)
    check("rep_order", text.index("nav.list.down") < text.index("held-j-sweep") < text.index("nav.grid.enter"), True)
    # Gate: the same verdicts as report, one BREACH line per journey over ceiling, missing never passes.
    def run_gate(rows, part="x", samples=20):
        mani2 = {"manifest": {"date": "d", "host": "h", "flea_head": "c7e23485e",
                              "plan": {"part": part, "samples": samples},
                              "repeat": {"delay_ms": 250, "rate": 40, "source": "plan"}}}
        with tempfile.NamedTemporaryFile("w", suffix=".jsonl", delete=False) as tf:
            tf.write(json.dumps(mani2) + "\n")
            for r in rows:
                tf.write(json.dumps(r) + "\n")
        buf = io.StringIO()
        with redirect_stdout(buf):
            code = gate([tf.name])
        os.unlink(tf.name)
        return code, buf.getvalue()

    under = [{"journey": "nav.list.down", "row": 1, "view": "list", "first_ms": 5.0, "fixture": "local"}
             for _ in range(20)]
    code, gtext = run_gate(under)
    check("gate_pass_code", code, 0)
    check("gate_pass_line", "GATE PASS journeys=1" in gtext, True)
    check("gate_pass_quiet", ("GATE BREACH" in gtext, "GATE MISSING" in gtext), (False, False))
    buf = io.StringIO()
    with tempfile.NamedTemporaryFile("w", suffix=".jsonl", delete=False) as tf:
        tf.write(json.dumps({"manifest": {"date": "d", "host": "h", "flea_head": "c7e23485e",
                                           "plan": {"part": "x", "samples": 20},
                                           "repeat": {"delay_ms": 250, "rate": 40, "source": "plan"}}}) + "\n")
        for r in under:
            tf.write(json.dumps(r) + "\n")
    with redirect_stdout(buf):
        report([tf.name])
    os.unlink(tf.name)
    check("gate_pass_report", "TARGET" in buf.getvalue(), True)
    over = under + [{"journey": "nav.grid.enter", "row": 3, "view": "grid", "first_ms": 140.0, "fixture": "local"}
                    for _ in range(20)]
    code, gtext = run_gate(over)
    check("gate_breach_code", code, 1)
    check("gate_breach_line", "GATE BREACH nav.grid.enter grid local p95=140.0 ceiling=100" in gtext, True)
    check("gate_breach_fail", "GATE FAIL breaches=1 journeys=2" in gtext, True)
    short = under + [{"journey": "nav.list.up", "row": 1, "view": "list", "first_ms": 5.0, "fixture": "local"}
                     for _ in range(3)]
    short.append({"journey": "nav.list.fling", "row": 1, "view": "list", "first_ms": "no instrument",
                  "note": "why", "fixture": "local"})
    code, gtext = run_gate(short)
    check("gate_missing_code", code, 2)
    check("gate_missing_short", "GATE MISSING nav.list.up list local n=3 needs 20" in gtext, True)
    check("gate_missing_noinst", "GATE MISSING nav.list.fling list local no instrument" in gtext, True)
    check("gate_missing_fail", ("GATE FAIL" in gtext, "GATE PASS" in gtext), (True, False))
    # Minima from the sampling plan: .first journeys need one row, plain ones n (n-1 by a .first).
    p7 = planned_counts("p7-load", 20)
    check("plan_p7_first", p7[("open.ql.txt.first", "dual", "local+load-a")], 1)
    check("plan_p7_plain", p7[("open.ql.txt", "dual", "local+load-a")], 19)
    check("plan_p7_pairs", p7[("nav.dual.down", "dual", "local+load-b")], 20)
    p4 = planned_counts("p4-open", 20)
    check("plan_p4_first", p4[("open.ql.txt.first", "list", "local")], 1)
    check("plan_p4_plain", p4[("open.ql.txt", "list", "local")], 20)
    check("plan_p6_long", planned_counts("p6-ops", 20)[("op.copy.long", "list", "local")], 3)

    def plan_rows(counts):
        rows = []
        for (journey, view, fixture), n in counts.items():
            row = row_of(journey, fixture.split("+")[0])
            for _ in range(n):
                r = {"journey": journey, "view": view, "fixture": fixture, "first_ms": 5.0}
                if row == 2:
                    r["held"] = {"slots_missed": 0, "overshoot": 0, "steps_behind": 0}
                if row == 5:
                    r["settled_ms"] = 50.0
                rows.append(r)
        return rows

    full = plan_rows(planned_counts("p7-load", 20))
    code, gtext = run_gate(full, "p7-load", 20)
    check("gate_plan_pass_code", code, 0)
    check("gate_plan_pass_line", "GATE PASS" in gtext, True)
    code, gtext = run_gate(full[:-1], "p7-load", 20)
    check("gate_plan_short_code", code, 2)
    check("gate_plan_short_line", "GATE MISSING" in gtext, True)
    kept = [r for r in full if (r["journey"], r["fixture"]) != ("open.ql.txt.first", "local+load-a")]
    code, gtext = run_gate(kept, "p7-load", 20)
    check("gate_plan_first_gone_code", code, 2)
    check("gate_plan_first_gone_line",
          "GATE MISSING open.ql.txt.first dual local+load-a n=0 needs 1" in gtext, True)
    code, gtext = run_gate(full[:5], "p7-load", 20)
    check("gate_truncated_code", code, 2)
    check("gate_truncated_line", ("GATE MISSING" in gtext, "GATE PASS" in gtext), (True, False))
    try:
        with redirect_stderr(io.StringIO()):
            main(["gate", "census-p9-typ0.jsonl"])
        fail.append("typo_gate: a typo'd path was dropped instead of refused")
    except SystemExit as e:
        check("typo_gate_code", e.code, 2)
    miss2 = [dict(r) for r in full]
    n = 0
    for r in miss2:
        if r["journey"] == "open.ql.txt" and r["fixture"] == "local+load-a" and n < 2:
            r["first_ms"] = None
            n += 1
    code, gtext = run_gate(miss2, "p7-load", 20)
    check("gate_miss_code", code, 1)
    check("gate_miss_line", "GATE BREACH open.ql.txt dual local+load-a p95=miss ceiling=100" in gtext, True)
    # clean outside the parent names both paths, exits non-zero, and still removes the stick root.
    with tempfile.TemporaryDirectory() as td:
        usb = os.path.join(td, "u", "v", "flea-instant-1")
        os.makedirs(os.path.join(usb, "dst"))
        open(os.path.join(usb, MARKER), "w").close()
        local = os.path.join(td, "local-root")
        os.makedirs(local)
        open(os.path.join(local, MARKER), "w").close()
        with open(os.path.join(local, "fixtures.json"), "w") as f:
            json.dump({"usb": usb}, f)
        if not os.path.realpath(local).startswith(LOCAL_PARENT + "/"):
            err = io.StringIO()
            with redirect_stderr(err):
                check("clean_outside_code", clean(local), 1)
            check("clean_outside_names", (os.path.realpath(local) in err.getvalue(),
                                          LOCAL_PARENT in err.getvalue()), (True, True))
            check("clean_outside_usb", os.path.exists(usb), False)
    # A load-b session's own dst directory is removed; anything not named dst- is refused.
    with tempfile.TemporaryDirectory() as td:
        usb = os.path.join(td, "u", "flea-instant-9")
        dst = os.path.join(usb, "dst", "dst-abc")
        os.makedirs(dst)
        open(os.path.join(usb, MARKER), "w").close()
        open(os.path.join(dst, "zzz_big.bin"), "w").close()
        drop_load_dst(dst, [usb])
        check("load_dst_removed", (os.path.exists(dst), os.path.isdir(usb)), (False, True))
        try:
            drop_load_dst(os.path.join(usb, "dst"), [usb])
            fail.append("load_dst_guard: a non-dst directory was removed")
        except SystemExit:
            pass
    if fail:
        print("\n".join("FAIL " + f for f in fail))
        return 1
    print("plan cases: full planned set passes, one row short is MISSING, a miss p95 is a BREACH")
    print("SELFTEST ok (%d journeys across %d parts)" % (len(cover), len(PARTS)))
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]

    def opt(name, default=None):
        return rest[rest.index(name) + 1] if name in rest else default

    def jsonl_paths(args):
        """Existing .jsonl files past --out FILE; anything else fails loud."""
        paths, skip = [], False
        for a in args:
            if skip:
                skip = False
                continue
            if a == "--out":
                skip = True
                continue
            if not a.endswith(".jsonl") or not os.path.isfile(a):
                print("need an existing .jsonl file, not %r" % a, file=sys.stderr)
                raise SystemExit(2)
            paths.append(a)
        return paths

    if cmd == "selftest":
        return selftest()
    if cmd == "budget":
        return budget_json()
    if cmd == "report":
        return report(jsonl_paths(rest), opt("--out"))
    if cmd == "gate":
        return gate(jsonl_paths(rest), opt("--out"))
    if cmd == "fixtures":
        print(json.dumps(build_fixtures(rest[0], opt("--usb"), opt("--nas")), indent=1))
        return 0
    if cmd == "clean":
        return clean(rest[0])
    if cmd == "calibrate":
        return calibrate(int(opt("--runs", 10)))
    if cmd == "run":
        return run_part(rest[0], opt("--root"), opt("--flea"), opt("--out"), int(opt("--samples", 20)),
                        "--dry" in rest, "--no-evidence" not in rest)
    if cmd == "measure":
        with open(rest[0]) as f:
            plan = json.load(f)
        return run_part(plan["part"], plan["root"], plan["flea"], plan["out"], plan.get("samples", 20),
                        plan.get("dry", False), plan.get("evidence", True))
    print("unknown command " + cmd, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
