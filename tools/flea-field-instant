EV_REL, EV_SYN = 2, 0
REL_X, REL_Y, REL_WHEEL = 0, 1, 8
BTN_LEFT, BTN_RIGHT, BTN_MIDDLE = 0x110, 0x111, 0x112
MODIFIERS = (29, 42, 56, 97, 125)


def release_all(keys):
    """Every button and modifier up: a held one left by an earlier run makes the kernel drop the next press."""
    for code in (BTN_LEFT, BTN_RIGHT, BTN_MIDDLE) + MODIFIERS:
        keys._key(code, 0)


def rel(keys, code, value):
    keys._event(EV_REL, code, value)
    keys._event(EV_SYN, 0, 0)


def pointer_to(keys, x, y):
    """Warp to an output point, then a one pixel uinput wiggle so the client gets a motion with its frame."""
    S.dispatch("hl.dsp.cursor.move({ x = %d, y = %d })" % (x, y))
    time.sleep(0.05)
    rel(keys, REL_X, 1)
    time.sleep(0.02)
    rel(keys, REL_X, -1)
    time.sleep(0.05)
    pos = S.hypr("cursorpos").strip()
    px, py = (int(float(v)) for v in pos.split(","))
    if abs(px - x) > 3 or abs(py - y) > 3:
        raise RuntimeError("pointer at %s, wanted %d,%d" % (pos, x, y))


def click(keys, button):
    """One press and release back to back; the CLOCK_MONOTONIC ns just before the press."""
    t = time.monotonic_ns()
    keys._key(button, 1)
    keys._key(button, 0)
    return t


def wheel(keys, notches):
    """One wheel report, negative scrolls down; the CLOCK_MONOTONIC ns before the write."""
    t = time.monotonic_ns()
    rel(keys, REL_WHEEL, notches)
    return t


def touchpad():
    """tools/flea-touchpad as a module, or None with the reason when /dev/uinput is not writable."""
    T = SourceFileLoader("flea_touchpad", os.path.join(HERE, "flea-touchpad")).load_module()
    if not os.access(T.UINPUT, os.W_OK):
        return None, "%s is not writable, so no touchpad can be created" % T.UINPUT
    return T, None


def stroke(T, fd, dy_mm, ms):
    """A two-finger stroke released with no hold (a fling); the CLOCK_MONOTONIC ns of its first motion report."""
    dy = int(dy_mm * T.RES)
    x0 = y0 = T.SPAN // 2
    steps = max(2, ms // T.EVENT_STEP_MS)
    T.finger(fd, 0, 1, x0, y0)
    T.finger(fd, 1, 2, x0, y0)
    T.emit(fd, T.EV_KEY, T.BTN_TOUCH, 1)
    T.emit(fd, T.EV_KEY, T.BTN_TOOL_FINGER, 0)
    T.emit(fd, T.EV_KEY, T.BTN_TOOL_DOUBLETAP, 1)
    T.report(fd)
    t_first = None
    for step in range(1, steps + 1):
        y = y0 + dy * step // steps
        T.finger(fd, 0, 1, x0, y)
        T.finger(fd, 1, 2, x0, y)
        if t_first is None:
            t_first = time.monotonic_ns()
        T.report(fd)
        time.sleep(ms / 1000 / steps)
    T.finger(fd, 0, -1, x0, y0 + dy)
    T.finger(fd, 1, -1, x0, y0 + dy)
    T.emit(fd, T.EV_KEY, T.BTN_TOUCH, 0)
    T.emit(fd, T.EV_KEY, T.BTN_TOOL_DOUBLETAP, 0)
    T.report(fd)
    return t_first


# Recorder with a dump on the first change after an armed input, keeping the first drawn state.


class EvRecorder(S.Recorder):
    armed_ns = None

    def _read(self):
        for line in self.proc.stdout:
            f = line.split()
            with self.lock:
                if f and f[0] == "F" and len(f) in (8, 9):
                    self.frames.append((int(f[1]), int(f[3]), int(f[8]) if len(f) == 9 else -1))
                    self.detail.append(tuple(int(v) for v in f[1:]))
                    if self.armed_ns is not None and int(f[3]) > 0 and int(f[1]) > self.armed_ns:
                        self.armed_ns = None
                        self.proc.send_signal(signal.SIGUSR1)
                elif f and f[0] == "H":
                    self.header = f[1:]
                elif f and f[0] == "D":
                    self.dumps.append(f[1])


# Sandbox: every root the run writes into carries the marker, and nothing outside a marked root is ever removed.

MARKER = ".flea-test-sandbox"
LOCAL_PARENT = os.environ.get("FLEA_INSTANT_PARENT", "/home/flea-sandbox")  # where ROOT must live; a smoke points it at /tmp
MIN_ROOT_LEN = len("/home/x/y")  # a marked root must run deeper than this path


def marked(root):
    return os.path.isfile(os.path.join(root, MARKER))


def inside_marked(path, roots):
    """True when path is strictly inside one of roots and that root carries the marker."""
    real = os.path.realpath(path) if not os.path.islink(path) else os.path.join(
        os.path.realpath(os.path.dirname(path)), os.path.basename(path))
    for r in roots:
        rr = os.path.realpath(r)
        if real.startswith(rr + "/") and marked(rr) and len(rr) > MIN_ROOT_LEN:
            return True
    return False


def sandbox_rm(path, roots):
    """Remove path (file, link or tree) only when it is inside a marked root; refuse anything else loudly."""
    if not os.path.isabs(path) or not path.strip("/"):
        raise SystemExit("refusing to remove a relative or empty path: %r" % path)
    if not inside_marked(path, roots):
        raise SystemExit("refusing to remove %s: not inside a marked sandbox root" % path)
    if os.path.islink(path) or os.path.isfile(path):
        os.unlink(path)
    elif os.path.isdir(path):
        shutil.rmtree(path)


def empty_dir(path, roots):
    for name in os.listdir(path):
        sandbox_rm(os.path.join(path, name), roots)


def reflink(src, dst):
    subprocess.run(["cp", "-r", "--reflink=auto", src, dst], check=True)


