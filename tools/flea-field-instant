def journeys_of(sessions):
    """Every journey id a part's sessions time, for the dry check and the selftest."""
    out = set()
    for s in sessions:
        v = s.get("view")
        for sp in s.get("series", []):
            t = sp["type"]
            if t == "pairs":
                for a, b in sp["pairs"]:
                    out |= {"nav.%s.%s" % (v, CHORD_NAMES[a]), "nav.%s.%s" % (v, CHORD_NAMES[b])}
            elif t in ("scroll", "wheel", "fling"):
                out.add("nav.%s.%s" % (v, {"scroll": "down-scroll"}.get(t, t)))
            elif t == "held":
                out.add("nav.%s.held-j-sweep" % v)
            elif t == "cycle":
                for st in sp["steps"]:
                    if st.get("journey"):
                        out.add(st["journey"])
                        if sp.get("first_suffix"):
                            out.add(st["journey"] + sp["first_suffix"])
            elif t == "views":
                out |= {"view.switch.%s-%s" % p for p in zip(VIEW_CIRCUIT, VIEW_CIRCUIT[1:])}
            elif t == "land":
                out |= {"open.cols-preview.%s%s" % (kk, x) for kk in sp["kinds"] for x in ("", ".first")}
            elif t == "ql":
                out |= {"open.ql.%s%s" % (kk, x) for kk in sp["kinds"] for x in ("", ".first")}
            elif t == "search":
                out.add("search.type-to-first-result")
            elif t == "op":
                out.add(sp["op"])
    return out


# Synthetic fixtures facts for the plan: only usb/nas presence shapes the journeys gate expects.
PLAN_FX = {"root": "/home/flea-sandbox/x", "usb": "/run/media/u/s/flea-instant-1", "nas": "/run/user/1/gvfs/n/f-2"}


def planned_counts(part, samples=20, fx=None):
    """Rows per (journey, view, fixture) one part writes at samples; the minima gate checks."""
    out = {}

    def add(journey, view, fixture, n):
        out[(journey, view, fixture)] = out.get((journey, view, fixture), 0) + n

    for s in parts(fx or PLAN_FX, samples).get(part, []):
        if s.get("missing") or not s.get("series"):
            continue
        view, n, where = s.get("view"), s.get("n", samples), s.get("where", "local")
        fixture = where + ("+load-" + s["load"] if s.get("load") else "")
        for sp in s["series"]:
            t = sp["type"]
            if t == "pairs":
                for a, b in sp["pairs"]:
                    add("nav.%s.%s" % (view, CHORD_NAMES[a]), view, fixture, n)
                    add("nav.%s.%s" % (view, CHORD_NAMES[b]), view, fixture, n)
            elif t == "scroll":
                add("nav.%s.down-scroll" % view, view, fixture, n)
            elif t == "wheel":
                add("nav.%s.wheel" % view, view, fixture, 2 * n)
            elif t == "fling":
                add("nav.%s.fling" % view, view, fixture, n)
            elif t == "held":
                add("nav.%s.held-j-sweep" % view, view, fixture, n)
            elif t == "search":
                add("search.type-to-first-result", view, fixture, n)
            elif t == "views":
                for a, b in zip(VIEW_CIRCUIT, VIEW_CIRCUIT[1:]):
                    add("view.switch.%s-%s" % (a, b), view, fixture, n)
            elif t == "cycle":
                for st in sp["steps"]:
                    if not st.get("journey"):
                        continue
                    if sp.get("first_suffix"):
                        add(st["journey"], view, fixture, n - 1)
                        add(st["journey"] + sp["first_suffix"], view, fixture, 1)
                    else:
                        add(st["journey"], view, fixture, n)
            elif t == "land":
                for kk in sp["kinds"]:
                    add("open.cols-preview.%s" % kk, view, fixture, n)
                    add("open.cols-preview.%s.first" % kk, view, fixture, 1)
            elif t == "ql":
                for kk in sp["kinds"]:
                    add("open.ql.%s" % kk, view, fixture, n)
                    add("open.ql.%s.first" % kk, view, fixture, 1)
            elif t == "op":
                add(sp["op"], view, fixture, n)
    return out


