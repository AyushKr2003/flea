#!/usr/bin/python3

# The privileged half of the image flasher: one process per flash that asks polkit, unmounts,
# locks and opens the drive, handing back one descriptor over the socket it was started with.
#
# Python and gi rather than Rust, like tools/flea-portal: opening a device needs a D-Bus call
# that returns a Unix descriptor, and this crate has no dependencies at all. FLEA_UDISKS
# overrides this file's path, which is also the test seam. This helper never sees the image
# and never writes; it takes only identifiers on its argv.

import os
import socket
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

BUS = "org.freedesktop.UDisks2"
BLOCK_IFACE = "org.freedesktop.UDisks2.Block"
DRIVE_IFACE = "org.freedesktop.UDisks2.Drive"
FILESYSTEM_IFACE = "org.freedesktop.UDisks2.Filesystem"
ENCRYPTED_IFACE = "org.freedesktop.UDisks2.Encrypted"

# The one-byte answers Flea reads off the socket: ok carries a descriptor, the rest carry none.
STATUS_OK = b"O"
STATUS_DENIED = b"D"
STATUS_BUSY = b"B"
STATUS_CHANGED = b"C"
STATUS_ERROR = b"E"

OPEN_ACTION = "org.freedesktop.udisks2.open-device"
# O_EXCL | O_DIRECT | O_CLOEXEC, the flags TECH.md section 0 rules; O_SYNC is what OpenForRestore
# paid and what this design refuses. O_EXCL is 0o200000, O_DIRECT 0o40000, O_CLOEXEC 0o2000000.
OPEN_FLAGS = 0o200000 | 0o40000 | 0o2000000
# Buses a removable drive hangs off; the same set eligibility reads out of the sysfs device path.
REMOVABLE_BUSES = ("usb", "sdio", "ieee1394")


def say(message):
    print("flea-udisks: %s" % message, file=sys.stderr, flush=True)


def fail_sock(sock, status, message):
    say(message)
    try:
        sock.sendmsg([status], [])
    except OSError as error:
        say("could not answer Flea (%s)" % error)


def manager():
    # The daemon's whole tree, one proxy per interface; cached properties are read off each.
    return Gio.DBusObjectManagerClient.new_for_bus_sync(
        Gio.BusType.SYSTEM, Gio.DBusObjectManagerClientFlags.NONE,
        BUS, "/org/freedesktop/UDisks2", None, None, None)


def cached(proxy, name):
    if proxy is None:
        return None
    value = proxy.get_cached_property(name)
    return value.unpack() if value is not None else None


# A D-Bus ay as text, bytes on this PyGObject and a list of ints on older ones; anything else
# is refused, the same rule tools/flea-portal reads its ay options by.
def bytestring(value):
    if isinstance(value, bytes):
        raw = value
    elif isinstance(value, list):
        try:
            raw = bytes(value)
        except (TypeError, ValueError):
            return ""
    else:
        return ""
    return raw.split(b"\0", 1)[0].decode("utf-8", "replace")


# One block device as plain data: the gi proxy stays at the edge, every decision below reads this.
def block_info(proxy):
    if proxy is None:
        return None
    return {"Device": bytestring(cached(proxy, "Device")),
            "Size": cached(proxy, "Size") or 0,
            "Drive": cached(proxy, "Drive") or "/",
            "HintSystem": cached(proxy, "HintSystem")}


def drive_info(proxy):
    if proxy is None:
        return None
    return {"HintSystem": cached(proxy, "HintSystem"),
            "Removable": cached(proxy, "Removable"),
            "MediaRemovable": cached(proxy, "MediaRemovable"),
            "ConnectionBus": cached(proxy, "ConnectionBus"),
            "Serial": cached(proxy, "Serial")}


def mount_points(proxy):
    return [bytestring(mount) for mount in cached(proxy, "MountPoints") or []]


def cleartext(proxy):
    return cached(proxy, "CleartextDevice") or "/"


def blocks():
    # Every block device on the daemon, path beside its plain data.
    out = []
    for obj in manager().get_objects():
        proxy = obj.get_interface(BLOCK_IFACE)
        info = block_info(proxy)
        if info is None:
            continue
        out.append((obj.get_object_path(), info))
    return out


def drive_for(drive_path):
    proxy = Gio.DBusProxy.new_for_bus_sync(
        Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None,
        BUS, drive_path, DRIVE_IFACE, None)
    return drive_info(proxy)


def on_drive(dev, device):
    # The disk itself or one of its partitions, /dev/sda beside /dev/sda1 and nvme0n1 beside
    # nvme0n1p1, never a longer name sharing the prefix, /dev/sdaa.
    prefix = "/dev/" + dev
    if device == prefix:
        return True
    if not device.startswith(prefix):
        return False
    tail = device[len(prefix):]
    return tail[:1].isdigit() or tail.startswith("p")


def iface_at(path, iface):
    try:
        return Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None, BUS, path, iface, None)
    except GLib.Error:
        return None


def is_system_drive(drive):
    if drive is None:
        return True
    if drive.get("HintSystem", True):
        return True
    if drive.get("Removable", False) or drive.get("MediaRemovable", False):
        return False
    bus = str(drive.get("ConnectionBus", ""))
    return bus not in REMOVABLE_BUSES


def error_name(error):
    # The machine half of a D-Bus failure: "GDBus.Error:org.freedesktop.UDisks2.Error.DeviceBusy:
    # ...". The text after the second colon is prose in the daemon's language and is never read.
    text = str(getattr(error, "message", error))
    marker = "GDBus.Error:"
    if marker not in text:
        return ""
    return text.split(marker, 1)[1].split(":")[0]


def busy_name(name):
    return "Busy" in name or "Mounted" in name


def denied_name(name):
    return "NotAuthorized" in name or "Dismissed" in name or "AuthFailed" in name


def check_open_authorized():
    # Asked first, before anything changes, so a dismissed prompt leaves the drive untouched.
    # This is what pkcheck --allow-user-interaction does; the grant it keeps is what the later
    # OpenDevice finds, so the user is asked once.
    import subprocess
    try:
        done = subprocess.run(
            ["pkcheck", "--action-id", OPEN_ACTION,
             "--process", str(os.getpid()), "--allow-user-interaction"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as error:
        say("pkcheck did not run (%s), so the open carries the prompt" % error)
        return True
    return done.returncode == 0


def unmount_all(dev):
    # Every mounted filesystem on the drive, never forced; a foreign mount keeps its password.
    for path, block in blocks():
        if not on_drive(dev, block["Device"]):
            continue
        proxy = iface_at(path, FILESYSTEM_IFACE)
        if proxy is None or not mount_points(proxy):
            continue
        try:
            proxy.call_sync("Unmount", GLib.Variant("(a{sv})", ({},)),
                            Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION, -1, None)
        except GLib.Error as error:
            # Decided from the error name alone; the message past it is the daemon's language.
            name = error_name(error)
            say("Unmount refused with %s" % (name or "an unnamed error"))
            return "busy" if busy_name(name) else "error"
    return ""


def lock_all(dev):
    for path, block in blocks():
        if not on_drive(dev, block["Device"]):
            continue
        proxy = iface_at(path, ENCRYPTED_IFACE)
        if proxy is None or cleartext(proxy) != "/":
            continue
        try:
            proxy.call_sync("Lock", GLib.Variant("(a{sv})", ({},)),
                            Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION, -1, None)
        except GLib.Error as error:
            name = error_name(error)
            say("Lock refused with %s" % (name or "an unnamed error"))
            return "busy" if busy_name(name) else "error"
    return ""


def cmd_drives(devs):
    import json
    try:
        listed = blocks()
    except GLib.Error:
        # The daemon is unreachable; the backend keeps every drive on an unreadable answer.
        print(json.dumps({"drives": []}))
        return 0
    bydev = {}
    for _path, block in listed:
        bydev.setdefault(block["Device"], block)
    kept = []
    for dev in devs:
        block = None
        for device, info in bydev.items():
            if on_drive(dev, device):
                block = info
                break
        if block is None:
            continue
        kept.append({"dev": dev, "system": is_system_drive(drive_for(block["Drive"]))})
    print(json.dumps({"drives": kept}))
    return 0


def cmd_open(dev, serial, size):
    try:
        sock = socket.fromfd(sys.stdin.fileno(), socket.AF_UNIX, socket.SOCK_SEQPACKET)
    except OSError as error:
        say("no socket to answer on (%s)" % error)
        return 1
    try:
        listed = blocks()
    except GLib.Error:
        fail_sock(sock, STATUS_ERROR, "udisks answered nothing")
        return 1
    found = [(path, block) for path, block in listed if on_drive(dev, block["Device"])]
    if not found:
        fail_sock(sock, STATUS_CHANGED, "/dev/%s is no longer there" % dev)
        return 0
    block_path, block = found[0]
    drive = drive_for(block["Drive"])
    if is_system_drive(drive):
        fail_sock(sock, STATUS_CHANGED, "/dev/%s is a system disk" % dev)
        return 0
    if serial and str((drive or {}).get("Serial", "")) != serial:
        fail_sock(sock, STATUS_CHANGED, "/dev/%s changed since it was chosen" % dev)
        return 0
    if size and int(block.get("Size", 0)) != size:
        fail_sock(sock, STATUS_CHANGED, "/dev/%s changed since it was chosen" % dev)
        return 0
    if not check_open_authorized():
        fail_sock(sock, STATUS_DENIED, "the password prompt was closed")
        return 0
    refused = unmount_all(dev)
    if refused == "busy":
        fail_sock(sock, STATUS_BUSY, "a volume on /dev/%s would not unmount" % dev)
        return 0
    if refused:
        fail_sock(sock, STATUS_ERROR, "a volume on /dev/%s could not be unmounted" % dev)
        return 0
    refused = lock_all(dev)
    if refused == "busy":
        fail_sock(sock, STATUS_BUSY, "a volume on /dev/%s would not lock" % dev)
        return 0
    if refused:
        fail_sock(sock, STATUS_ERROR, "a volume on /dev/%s could not be locked" % dev)
        return 0
    proxy = Gio.DBusProxy.new_for_bus_sync(
        Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None, BUS, block_path, BLOCK_IFACE, None)
    # call_with_unix_fd_list_sync answers (result, out_fd_list); the (h) handle indexes the list.
    try:
        result, out_list = proxy.call_with_unix_fd_list_sync(
            "OpenDevice", GLib.Variant("(sa{sv})", ("rw", {"flags": GLib.Variant("u", OPEN_FLAGS)})),
            GLib.VariantType("(h)"), Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION, -1, None, None)
        fd = out_list.get(result.unpack()[0])
    except GLib.Error as error:
        name = error_name(error)
        say("OpenDevice refused with %s" % (name or "an unnamed error"))
        if denied_name(name):
            fail_sock(sock, STATUS_DENIED, "the password prompt was closed")
        else:
            fail_sock(sock, STATUS_ERROR, "udisks refused to open /dev/%s" % dev)
        return 0
    except (TypeError, IndexError) as error:
        fail_sock(sock, STATUS_ERROR, "udisks opened nothing for /dev/%s (%s)" % (dev, error))
        return 0
    try:
        socket.send_fds(sock, [STATUS_OK], [fd])
    except OSError as error:
        fail_sock(sock, STATUS_ERROR, "the descriptor did not cross (%s)" % error)
        return 1
    return 0


def cmd_eject(dev):
    import json
    try:
        listed = blocks()
    except GLib.Error:
        print(json.dumps({"ok": False, "err": "error"}))
        return 0
    found = [(path, block) for path, block in listed if on_drive(dev, block["Device"])]
    if not found:
        print(json.dumps({"ok": False, "err": "gone"}))
        return 0
    _block_path, block = found[0]
    refused = unmount_all(dev)
    if refused:
        print(json.dumps({"ok": False, "err": refused}))
        return 0
    drive_path = block.get("Drive", "/")
    proxy = Gio.DBusProxy.new_for_bus_sync(
        Gio.BusType.SYSTEM, Gio.DBusProxyFlags.NONE, None, BUS, drive_path, DRIVE_IFACE, None)
    try:
        proxy.call_sync("PowerOff", GLib.Variant("(a{sv})", ({},)),
                        Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION, -1, None)
    except GLib.Error as error:
        name = error_name(error)
        say("PowerOff refused with %s" % (name or "an unnamed error"))
        print(json.dumps({"ok": False, "err": "busy" if busy_name(name) else "error"}))
        return 0
    print(json.dumps({"ok": True}))
    return 0


def main(argv):
    if len(argv) < 2:
        say("takes drives, open or eject")
        return 2
    if argv[1] == "drives":
        return cmd_drives(argv[2:])
    if argv[1] == "open":
        if len(argv) != 5:
            say("open takes a device, a serial and a size")
            return 2
        try:
            size = int(argv[4])
        except ValueError:
            say("open takes a device, a serial and a size")
            return 2
        return cmd_open(argv[2], argv[3], size)
    if argv[1] == "eject":
        if len(argv) != 3:
            say("eject takes a device")
            return 2
        return cmd_eject(argv[2])
    say("takes drives, open or eject")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
