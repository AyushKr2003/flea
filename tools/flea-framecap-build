#!/bin/bash
# Builds tools/flea-framecap into DIR (default a new mktemp -d) and prints the binary's path.
# Needs gcc, wayland-scanner, libwayland-client and the wayland-protocols staging XML, and names whichever is missing.
set -uo pipefail
src=$(cd "$(dirname "$0")" && pwd)
dir=${1:-$(mktemp -d)} || exit 1
mkdir -p "$dir" || exit 1
protocols=${WAYLAND_PROTOCOLS:-/usr/share/wayland-protocols}/staging
for tool in gcc wayland-scanner; do
  command -v "$tool" >/dev/null || { echo "flea-framecap-build: $tool is not installed" >&2; exit 1; }
done
# ext-image-capture-source names a toplevel handle, so its list protocol is part of the link even though it is never used.
objs=()
for x in ext-image-capture-source/ext-image-capture-source-v1 ext-image-copy-capture/ext-image-copy-capture-v1 \
         ext-foreign-toplevel-list/ext-foreign-toplevel-list-v1; do
  xml=$protocols/$x.xml
  [ -r "$xml" ] || { echo "flea-framecap-build: $xml is missing, install wayland-protocols" >&2; exit 1; }
  b=$(basename "$x")
  wayland-scanner client-header "$xml" "$dir/$b-client-protocol.h" || exit 1
  wayland-scanner private-code "$xml" "$dir/$b-protocol.c" || exit 1
  objs+=("$dir/$b-protocol.c")
done
gcc -O2 -Wall -Wextra -Werror -I"$dir" -o "$dir/flea-framecap" "$src/flea-framecap.c" "${objs[@]}" -lwayland-client \
  || { echo "flea-framecap-build: the compile failed (libwayland-client headers needed)" >&2; exit 1; }
printf '%s\n' "$dir/flea-framecap"
